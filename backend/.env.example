# PostgreSQL Database Connection String
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:root@localhost:5432/taskflow_db

# Secret key used for signing JWT access tokens (use a strong random string in production)
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production

# Google Gemini API Key for AI-assisted task triage (obtained from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Gemini model name (gemini-2.0-flash is faster, smarter, and free on Google AI Studio)
GEMINI_MODEL=gemini-2.0-flash
